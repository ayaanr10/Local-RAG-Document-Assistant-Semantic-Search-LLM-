# Optional; if absent the app displays passages without LLM generation.
GEMINI_API_KEY=
# Check Google AI Studio for the supported model ID on your account.
GEMINI_MODEL=gemini-3.6-flash
# '1' isolates uploaded collections per browser session; recommended for public demos.
PUBLIC_DEMO=0
RAG_DB_PATH=data/chroma
# sentence-transformers is default for local use; fastembed uses smaller ONNX runtime.
EMBEDDING_BACKEND=sentence-transformers
